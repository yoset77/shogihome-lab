{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShogiHomeLab",
  "mainBinaryName": "ShogiHomeLab",
  "version": "1.20.0",
  "identifier": "lab.shogihome.ShogiHomeLab",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
