# エンジンラッパーが待ち受けるTCPポート番号
# shogihomeサーバーの .env 内の REMOTE_ENGINE_PORT と一致させる必要があります
LISTEN_PORT=4082

# バインディングアドレス
# 127.0.0.1: ローカルホストのみ許可 (shogihomeサーバーと同じPCで動かす場合)
# 0.0.0.0: 外部からの接続を許可 (shogihomeサーバーと別PCの場合)
BIND_ADDRESS=127.0.0.1

# 注意: エンジンのパス設定は 'engines.json' ファイルで行います。
# 'engines.json.example' を参考に作成してください。

# 接続認証トークン (ループバック以外で待ち受ける場合は必須)
# 設定する場合は32文字以上のランダムな値にしてください。
# shogihomeサーバー側と同じ値を設定してください。未設定・空文字での起動はループバック限定です。
# 次のコマンドで生成できます (Node.jsが必要)。
# node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
# WRAPPER_ACCESS_TOKEN=

# Windows: エンジン起動時に HighQoS を明示指定 (既定: false)
# cmd/bat 経由ではエンジン本体への適用は保証されません。
# ENGINE_HIGH_QOS=true
